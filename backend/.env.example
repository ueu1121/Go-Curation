# Backend environment contract. Copy to backend/.env and fill in. Placeholders only — never commit real values.
MONGO_URL="mongodb://<host>:27017"
DB_NAME="<database-name>"
CORS_ORIGINS="<https://your-frontend-origin>"
APP_ENV="development"
DEMO_MODE="true"
JWT_SECRET="<64-hex-chars: python -c 'import secrets;print(secrets.token_hex(32))'>"
SESSION_TTL_DAYS="7"
LOGIN_MAX_ATTEMPTS="5"
LOGIN_LOCK_MINUTES="15"
COOKIE_SECURE="true"
ADMIN_EMAILS="<admin-participant-email>"
AUTOMATION_API_KEY="<long-random-string-for-n8n>"
AUTOMATION_HOUSEHOLD_SLUG="primary"
DEV_PARTICIPANT_A_EMAIL="participant.a@example.invalid"
DEV_PARTICIPANT_A_PASSWORD="<generate-locally>"
DEV_PARTICIPANT_B_EMAIL="participant.b@example.invalid"
DEV_PARTICIPANT_B_PASSWORD="<generate-locally>"
INTERPRETER_PROVIDER="guided"
RESEARCH_PROVIDER="disabled"
NOTIFICATION_PROVIDER="disabled"
STATIC_DIR=""
