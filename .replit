modules = ["nodejs-20", "web", "python-3.11"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.development]
ADMIN_EMAILS = "participant.a@example.invalid"
APP_ENV = "development"
AUTOMATION_HOUSEHOLD_SLUG = "primary"
COOKIE_SECURE = "true"
DB_NAME = "curator_replit_dev"
DEMO_MODE = "true"
DEV_PARTICIPANT_A_EMAIL = "participant.a@example.invalid"
DEV_PARTICIPANT_B_EMAIL = "participant.b@example.invalid"
INTERPRETER_PROVIDER = "guided"
NOTIFICATION_PROVIDER = "disabled"
RESEARCH_PROVIDER = "disabled"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "nvm use && node \"$(command -v yarn)\" build && PORT=5000 STATIC_DIR=../frontend/build node \"$(command -v yarn)\" start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
